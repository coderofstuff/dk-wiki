digraph conflict_zone {
    rankdir=BT;
    nodesep=0.8;
    ranksep=0.1;
    node [shape=circle, style=filled, fontsize=10, width=0.6, height=0.6, fillcolor=lightgray];
    edge [arrowsize=0.6, color=gray60];

    label="Virtual, the next unmined block, pointing to the DAG tips";
    labelloc=b;

    // Left side (matches agreement cluster structure, invisible border)
    subgraph cluster_left {
        label="";
        labelloc=b;
        style="dashed";
        color=white;
        penwidth=0;
        B [label="B"];
        D [label="D"];
        F [label="F"];
        T1 [label="T1", fillcolor="lightgreen"];
    }

    // Right side (matches agreement cluster structure, invisible border)
    subgraph cluster_right {
        label="";
        labelloc=b;
        style="dashed";
        color=white;
        penwidth=0;
        E [label="E"];
        G [label="G"];
        T2 [label="T2", fillcolor="lightgreen"];
        H [label="H"];
        T3 [label="T3", fillcolor="lightgreen"];
        C [label="C"];
    }

    // Bottom blocks
    CG [label="CG"];
    X1 [label="X1"];
    X2 [label="X2"];

    // Virtual block
    Virtual [label="Virtual", shape=circle, style=dotted, fillcolor=lightgray];

    // Blue edges = selected parent (chain-parent path)
    B -> CG [color=blue, penwidth=2.0];
    C -> CG [color=blue, penwidth=2.0];
    D -> B [color=blue, penwidth=2.0];
    E -> C [color=blue, penwidth=2.0];
    F -> D [color=blue, penwidth=2.0];
    G -> E [color=blue, penwidth=2.0];
    H -> E [color=blue, penwidth=2.0];
    T1 -> F [color=blue, penwidth=2.0];
    T2 -> G [color=blue, penwidth=2.0];
    T3 -> H [color=blue, penwidth=2.0];

    // Gray dashed edges = non-selected parents
    F -> C [color=gray60, penwidth=1.0, style=dashed];
    T2 -> H [color=gray60, penwidth=1.0, style=dashed];
    E -> B [color=gray60, penwidth=1.0, style=dashed];

    // B -> X1 and C -> X2 are non-selected parents
    B -> X1 [color=gray60, penwidth=1.0, style=dashed];
    C -> X2 [color=gray60, penwidth=1.0, style=dashed];

    // Virtual block points to all tips
    Virtual -> T1 [color=gray60, penwidth=1.0, style=dashed];
    Virtual -> T2 [color=gray60, penwidth=1.0, style=dashed];
    Virtual -> T3 [color=gray60, penwidth=1.0, style=dashed];
}
