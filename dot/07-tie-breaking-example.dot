digraph tie_breaking_example {
    rankdir=RL;
    nodesep=0.5;
    ranksep=0.4;
    node [shape=circle, style=filled, fontsize=9, width=0.6, height=0.6];
    edge [arrowsize=0.5, color=gray60];

    label="Tie-Breaking: subgroup with earliest latest-witness wins";

    GEN [label="genesis", fillcolor=orange];
    A [label="A", fillcolor=lightskyblue];
    B [label="B", fillcolor=lightskyblue, shape=doublecircle, xlabel="witness"];
    C [label="C", fillcolor=lightskyblue, shape=doublecircle, xlabel="witness"];
    D [label="D", fillcolor=lightskyblue, shape=doublecircle, xlabel="witness"];
    E [label="E", fillcolor=lightskyblue];

    // Reference cluster
    subgraph cluster_f {
        label="Reference Cluster F (free search at g(k))\nF = {genesis, A, B, C, D, E}";
        labelloc=t;
        style=filled;
        fillcolor=aliceblue;

        A -> GEN;
        B -> A;
        C -> A;
        D -> B;
        E -> C;
    }

    subgraph cluster_result {
        style=invis;
        WINNER [label="Subgroup 1: conditioned chain = {genesis, A, D}\nWitnesses C₁ = {B, C}\nmax(C₁) = C, blue_work = 100\n\nSubgroup 2: conditioned chain = {genesis, A, E}\nWitnesses C₂ = {B, C, D}\nmax(C₂) = D, blue_work = 150\n\nWinner: Subgroup 1 (lower blue_work of latest witness)", shape=box, style=filled, fillcolor=lightgreen, fontsize=9];
    }
}
