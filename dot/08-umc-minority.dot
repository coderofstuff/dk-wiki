digraph umc_minority_fail {
    rankdir=RL;
    nodesep=0.5;
    ranksep=0.4;
    node [shape=circle, style=filled, fontsize=9, width=0.6, height=0.6];
    edge [arrowsize=0.5, color=gray60];

    label="UMC Voting: Minority Blues → FAIL";

    GEN [label="1", fillcolor=lightskyblue, shape=doublecircle, xlabel="blue"];
    B2 [label="2", fillcolor=lightskyblue, xlabel="blue"];
    B3 [label="3", fillcolor=salmon, xlabel="red"];
    B4 [label="4", fillcolor=lightskyblue, xlabel="blue"];
    B5 [label="5", fillcolor=salmon, xlabel="red"];
    B6 [label="6", fillcolor=salmon, xlabel="red"];

    // Edges point backwards (newer → older)
    B6 -> B4;
    B6 -> B5;
    B4 -> B2;
    B5 -> B3;
    B2 -> GEN;
    B3 -> GEN;

    subgraph cluster_result {
        style=invis;
        RESULT [label="Blues: {1,2,4} → minority\nReds: {3,5,6} → majority\n\nvote(GEN) = negative → UMC fails", shape=box, style=filled, fillcolor=mistyrose, fontsize=9];
    }
}
