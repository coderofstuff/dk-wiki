digraph freeloading_attack {
    rankdir=TB;
    node [shape=circle, style=filled, fontsize=9];
    edge [arrowsize=0.6, color=gray60];

    label="Freeloading attack on PHANTOM (k=5) — DAGKnight whitepaper example\nAttacker creates chain A1→A2→A3→A4→A5→A6 referencing H6.\nAt k=5, all attacker blocks fit in the 5-cluster (blue, dashed).\nHonest blocks H7–H11 are excluded (red) — the attack succeeds.\nWithout DAGKnight's adaptive rank, the attacker wins.";
    labelloc=t;

    GEN [label="H1\n(genesis)", fillcolor=orange, shape=doublecircle];

    // Honest blocks that survive (in the k=5 cluster)
    H2 [label="H2", fillcolor=lightskyblue];
    H3 [label="H3", fillcolor=lightskyblue];
    H4 [label="H4", fillcolor=lightskyblue];
    H5 [label="H5", fillcolor=lightskyblue];
    H6 [label="H6", fillcolor=lightskyblue];

    // Attacker blocks — BLUE because k=5 includes them in the cluster
    A1 [label="A1", fillcolor=lightskyblue, style="filled,dashed"];
    A2 [label="A2", fillcolor=lightskyblue, style="filled,dashed"];
    A3 [label="A3", fillcolor=lightskyblue, style="filled,dashed"];
    A4 [label="A4", fillcolor=lightskyblue, style="filled,dashed"];
    A5 [label="A5", fillcolor=lightskyblue, style="filled,dashed"];

    // Attacker block A6 connects both chains — BLUE (cluster member)
    A6 [label="A6", fillcolor=lightskyblue, style="filled,dashed"];

    // Honest blocks excluded by the attack — RED
    H7 [label="H7", fillcolor=salmon];
    H8 [label="H8", fillcolor=salmon];
    H9 [label="H9", fillcolor=salmon];
    H10 [label="H10", fillcolor=salmon];
    H11 [label="H11", fillcolor=salmon];

    // Virtual block
    V [label="V\n(virtual)", fillcolor=none, style="dashed", shape=circle];

    // Edges point backwards (newer → older)
    V -> H11;
    V -> A6;
    A6 -> H6;
    A6 -> A5;
    H11 -> H10;
    H10 -> H8;
    H10 -> H9;
    H8 -> H7;
    H9 -> H7;
    H7 -> H6;
    H6 -> H5;
    H5 -> H4;
    H4 -> H3;
    H3 -> H2;
    H2 -> GEN;
    A5 -> A4;
    A4 -> A3;
    A3 -> A2;
    A2 -> A1;
    A1 -> GEN;
}
