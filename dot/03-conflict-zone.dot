digraph conflict_zone {
    rankdir=BT;
    nodesep=0.5;
    ranksep=0.4;
    node [shape=circle, style=filled, fontsize=10, width=0.6, height=0.6];
    edge [arrowsize=0.6, color=gray60];

    label="Conflict Zone: future(CG) ∩ past(tips)\nThis is the only region DAGKnight needs to analyze";

    F [label="F", fillcolor=lightskyblue, xlabel="tips"];
    G [label="G", fillcolor=lightyellow];
    D [label="D", fillcolor=lightskyblue];
    E [label="E", fillcolor=lightyellow];
    C [label="C", fillcolor=orange, shape=doublecircle, xlabel="conflict genesis"];
    B [label="B", fillcolor=lightgray];
    GEN [label="genesis", fillcolor=lightgray];

    // Edges point backwards (newer → older)
    F -> D;
    G -> E;
    D -> C;
    E -> C;
    C -> B;
    B -> GEN;

    // Force ranking
    { rank=same; F; G; }
    { rank=same; D; E; }
    { rank=same; C; }
    { rank=same; B; }
    { rank=same; GEN; }

    // Conflict zone: between CG and tips (this is what DAGKnight analyzes)
    subgraph cluster_zone {
        label="Conflict Zone\nfuture(CG) ∩ past(tips)\nDAGKnight analyzes this region";
        labelloc=t;
        style=filled;
        fillcolor=moccasin;
        F; G; D; E; C;
    }

    // Resolved: below CG (already settled, no re-analysis needed)
    subgraph cluster_resolved {
        label="Already Resolved\nbelow conflict genesis\norder is stable";
        labelloc=b;
        style=filled;
        fillcolor=lightgray;
        B; GEN;
    }
}
