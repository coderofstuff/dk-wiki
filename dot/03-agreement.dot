digraph agreement_example {
    rankdir=BT;
    nodesep=0.8;
    ranksep=0.1;
    node [shape=circle, style=filled, fontsize=10, width=0.6, height=0.6];
    edge [arrowsize=0.6, color=gray60];

    label="Agreement: blocks sharing a chain-parent path above the conflict genesis";

    CG [label="CG", fillcolor=orange, shape=doublecircle];

    // Virtual block
    Virtual [label="Virtual", shape=circle, style=dotted, fillcolor=white];

    // Left side: chain CG → B → D → F → T1
    subgraph cluster_left {
        label="Left side";
        labelloc=b;
        style="dashed";
        color=blue;
        B [label="B", fillcolor=lightskyblue];
        D [label="D", fillcolor=lightskyblue];
        F [label="F", fillcolor=lightskyblue];
        T1 [label="T1", fillcolor=lightskyblue];
    }

     // Right side: chain CG → C → E → G → T2 (with T3 branching off H)
    subgraph cluster_right {
        label="Right side";
        labelloc=b;
        style="dashed";
        color=orange;
        C [label="C", fillcolor=lightyellow];
        E [label="E", fillcolor=lightyellow];
        G [label="G", fillcolor=lightyellow];
        T2 [label="T2", fillcolor=lightyellow];
        H [label="H", fillcolor=lightyellow];
        T3 [label="T3", fillcolor=lightyellow];
    }

    // CG label node
    CG_lbl [label="conflict genesis", shape=plaintext, style=filled, fillcolor=none, fontsize=10, fontcolor=gray40, width=0];

    // Annotation at bottom
    NOTE [label="Blue arrows = selected parent (chain-parent)\nDashed gray = non-selected parent\n\nChain-parent paths form a tree back to genesis:\nT1→F→D→B→CG (left side all agree)\nT2→G→E→C→CG (right side all agree)\nT3→H→E→C→CG (T3 also agrees with right side)\n\nD and E do NOT agree (different chain above CG)", shape=box, style=filled, fillcolor=lightcyan, fontsize=9, width=7];

    // Blue edges = selected parent (chain-parent path)
    D -> B [color=blue, penwidth=2.0];
    F -> D [color=blue, penwidth=2.0];
    T1 -> F [color=blue, penwidth=2.0];
    E -> C [color=blue, penwidth=2.0];
    G -> E [color=blue, penwidth=2.0];
    T2 -> G [color=blue, penwidth=2.0];
    H -> E [color=blue, penwidth=2.0];
    T3 -> H [color=blue, penwidth=2.0];

    // Blue to CG (selected parent of B and C)
    B -> CG [color=blue, penwidth=2.0];
    C -> CG [color=blue, penwidth=2.0];

    // Gray dashed = non-selected parent
    T2 -> H [color=gray60, penwidth=1.0, style=dashed];
    F -> C [color=gray60, penwidth=1.0, style=dashed];
    E -> B [color=gray60, penwidth=1.0, style=dashed];

    // Bottom chain from CG
    CG -> CG_lbl [style=invis];
    CG_lbl -> NOTE [style=invis];

    // Virtual block points to all tips
    Virtual -> T1 [color=gray60, penwidth=1.0, style=dashed];
    Virtual -> T2 [color=gray60, penwidth=1.0, style=dashed];
    Virtual -> T3 [color=gray60, penwidth=1.0, style=dashed];
}
